# Shared configuration for the `agent` wrapper scripts.
# Sourced by bin/agent. Override any value by exporting it before calling `agent`.

BOOTSTRAP_ROOT="${BOOTSTRAP_ROOT:-/home/patrickd/local-agent-bootstrap}"

# --- llama.cpp -------------------------------------------------------------
# NOTE: port 8080 is NOT available on this box - the pre-existing SearXNG
# container owns it. llama-server runs on 8090.
LLAMA_BIN="${LLAMA_BIN:-$BOOTSTRAP_ROOT/llama.cpp/build/bin/llama-server}"
LLAMA_MODEL="${LLAMA_MODEL:-$BOOTSTRAP_ROOT/models/Qwen3.5-4B-MTP-UD-Q5_K_XL.gguf}"
LLAMA_HOST="${LLAMA_HOST:-127.0.0.1}"
LLAMA_PORT="${LLAMA_PORT:-8090}"
LLAMA_ALIAS="${LLAMA_ALIAS:-qwen3.5-4b}"
LLAMA_CTX="${LLAMA_CTX:-131072}"
LLAMA_NGL="${LLAMA_NGL:-99}"
LLAMA_CACHE_TYPE="${LLAMA_CACHE_TYPE:-q8_0}"
# Speculative decoding via the model's built-in MTP head. Set to "none" to disable.
LLAMA_SPEC_TYPE="${LLAMA_SPEC_TYPE:-draft-mtp}"
# Thinking mode. Qwen3.5-4B is a reasoning model and at this size it reliably runs
# away inside an agent harness - a trivial OpenCode task burned 12,936 tokens in one
# completion without ever emitting a tool call. `--reasoning off` sets enable_thinking=false
# in the chat template and fixes it outright. Set to "on" to re-enable.
LLAMA_REASONING="${LLAMA_REASONING:-off}"
# Extra flags appended verbatim to the llama-server command line.
LLAMA_EXTRA_ARGS="${LLAMA_EXTRA_ARGS:-}"

# --- extractd (native Rust extraction service) ------------------------------
# Primary rung of the extraction ladder: fetch -> readability -> markdown, no
# browser. `agent up` builds it on first run if the binary is missing.
EXTRACTD_DIR="${EXTRACTD_DIR:-$BOOTSTRAP_ROOT/extractor}"
EXTRACTD_BIN="${EXTRACTD_BIN:-$EXTRACTD_DIR/target/release/extractd}"
EXTRACTD_PORT="${EXTRACTD_PORT:-11236}"
EXTRACTD_URL="${EXTRACTD_URL:-http://127.0.0.1:11236}"
EXTRACTD_CONCURRENCY="${EXTRACTD_CONCURRENCY:-32}"

# --- docker services -------------------------------------------------------
# `agent up` creates them if absent, starts them if stopped, and verifies them.
SEARXNG_URL="${SEARXNG_URL:-http://127.0.0.1:8080}"
SEARXNG_CONTAINER="${SEARXNG_CONTAINER:-searxng}"
SEARXNG_IMAGE="${SEARXNG_IMAGE:-searxng/searxng:latest}"
SEARXNG_PORT="${SEARXNG_PORT:-8080}"
CRAWL4AI_URL="${CRAWL4AI_URL:-http://127.0.0.1:11235}"
CRAWL4AI_CONTAINER="${CRAWL4AI_CONTAINER:-crawl4ai}"
CRAWL4AI_IMAGE="${CRAWL4AI_IMAGE:-unclecode/crawl4ai:latest}"
CRAWL4AI_PORT="${CRAWL4AI_PORT:-11235}"

# What `agent down` does with the containers:
#   started  stop only the ones this tool started (default - safe when the
#            containers are shared with other projects on the same box)
#   always   always stop them
#   never    never stop them
AGENT_STOP_CONTAINERS="${AGENT_STOP_CONTAINERS:-started}"

# --- runtime paths ---------------------------------------------------------
RUN_DIR="${RUN_DIR:-$BOOTSTRAP_ROOT/run}"
LOG_DIR="${LOG_DIR:-$BOOTSTRAP_ROOT/logs}"
LLAMA_PID_FILE="${LLAMA_PID_FILE:-$RUN_DIR/llama-server.pid}"
LLAMA_LOG="${LLAMA_LOG:-$LOG_DIR/llama-server.log}"
EXTRACTD_PID_FILE="${EXTRACTD_PID_FILE:-$RUN_DIR/extractd.pid}"
EXTRACTD_LOG="${EXTRACTD_LOG:-$LOG_DIR/extractd.log}"

# --- search behavior -------------------------------------------------------
# normal  = fetch + extract top results, summarize via Groq when available
# shallow = snippets only (used when decode speed drops below the threshold)
AGENT_SEARCH_MODE="${AGENT_SEARCH_MODE:-normal}"
# Clean-baseline decode tok/s for this box, written by `agent bench --save`.
BASELINE_FILE="${BASELINE_FILE:-$RUN_DIR/baseline_tps}"
# Drop to shallow mode below this fraction of the saved baseline.
SPEED_THRESHOLD="${SPEED_THRESHOLD:-0.70}"
